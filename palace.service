[Unit]
Description=Palace FastAPI App
After=network.target

[Service]
User=admin
WorkingDirectory=/var/www/palace/backend
Environment="PATH=/var/www/palace/venv/bin"
ExecStart=/var/www/palace/venv/bin/uvicorn main:app --host 127.0.0.1 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
