# copy to .env

# https://www.themoviedb.org/settings/api (v3 key)
TMDB_API_KEY=
# multiple keys, seperate by commas
# TMDB_API_KEYS=

# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# docker only, where the site is published on the host
# PALACE_BIND=127.0.0.1
# PALACE_PORT=8080
# backend port, always bound to 127.0.0.1
# PALACE_API_PORT=5080

# login tokens last this many days (default 30)
# JWT_EXPIRE_DAYS=30

# requests per minute per ip, and new accounts per hour per ip
# RATE_LIMIT_PER_MIN=600
# SIGNUP_LIMIT_PER_HOUR=10
